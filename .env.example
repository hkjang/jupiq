# jupiq가 읽는 런타임 환경변수는 아래 네 개뿐입니다.
# 운영 환경에서는 sslmode=verify-full과 검증 가능한 PostgreSQL 인증서를 권장합니다.
POSTGRES_DSN=postgres://jupiq:change-me@postgres.example.internal:5432/jupiq?sslmode=verify-full
BOOTSTRAP_ADMIN=admin
# 비워 둔 채로는 시작되지 않습니다. 최소 12자 이상의 고유한 임시 비밀번호를 입력하세요.
BOOTSTRAP_ADMIN_PASSWORD=
# AES-256 키: raw 32자, 64자 hex 또는 base64 인코딩된 32바이트. 생성: openssl rand -base64 32
ENCRYPTION_KEY=
